  <h1 class="decoration-primary dark:decoration-primary-light pb-10 text-balance underline decoration-4 underline-offset-8">{t('pages.legal-notice.title')}</h1>

  <div class="long-text-content">
    <p class="text-stone-500 italic dark:text-stone-300">{t('pages.legal-notice.intro')}:</p>
    <p class="select-none">
      <strong>Calendarverse GmbH</strong>
      <br />
      Beta-Str. 10a
      <br />
      85774 Unterf&ouml;hring
      <br />
      Allemagne
    </p>
    <p class="select-none">&#109;&#097;&#105;&#108;&#064;&#097;&#100;&#100;&#045;&#116;&#111;&#045;&#099;&#097;&#108;&#101;&#110;&#100;&#097;&#114;&#045;&#112;&#114;&#111;&#046;&#099;&#111;&#109;</p>
    <p>
      Si&egrave;ge social&nbsp;: Unterf&ouml;hring
      <br />
      Registre du commerce&nbsp;: HRB 312016, Tribunal d'instance de Munich
      <br />
      G&eacute;rant&nbsp;: Jens K&uuml;rschner
    </p>
    <p>Num&eacute;ro de TVA intracommunautaire&nbsp;: DE462121269</p>
