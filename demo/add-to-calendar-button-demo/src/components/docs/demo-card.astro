---
import type { AddToCalendarButtonType } from 'add-to-calendar-button';
import { Code } from 'astro-expressive-code/components';
import CalendarDemo from './calendar-demo.astro';
interface Props {
  id?: string;
  title: string;
  text?: string;
  headingLevel?: 'h2' | 'h3';
  config: AddToCalendarButtonType;
  code: string;
  demoPrefix?: string;
  stacked?: boolean;
  secondaryConfig?: AddToCalendarButtonType;
  secondaryCode?: string;
}
const { id, title, text, headingLevel = 'h3', config, code, demoPrefix, stacked = false, secondaryConfig, secondaryCode } = Astro.props;
const Heading = headingLevel;
---

<section {id} class="scroll-mt-8 rounded-2xl border border-zinc-300 bg-zinc-50 p-5 shadow-sm dark:border-zinc-700 dark:bg-zinc-900 md:p-8">
  <Heading class="!mt-0 !border-0 !pt-0 text-primary dark:text-primary-light">{title}</Heading>
  {text && <p>{text}</p>}
  <slot />
  <div class:list={['mt-6 flex flex-col gap-6', !stacked && 'xl:flex-row xl:items-start']}>
    <div class:list={['flex min-h-32 items-center justify-center rounded-xl bg-white p-6 text-center dark:bg-zinc-800', !stacked && 'xl:w-72 xl:shrink-0']}>
      {demoPrefix && <span class="pr-6">{demoPrefix}! →</span>}
      <CalendarDemo {config} />
    </div>
    <div class="min-w-0 flex-1">
      <Code {code} lang="html" />
    </div>
  </div>
  {secondaryConfig && secondaryCode && (
    <>
      <div class="mt-8">
        <slot name="between" />
      </div>
      <div class="mt-6 flex flex-col gap-6 xl:flex-row xl:items-start">
        <div class="flex min-h-32 items-center justify-center rounded-xl bg-white p-6 xl:w-72 xl:shrink-0 dark:bg-zinc-800">
          <CalendarDemo config={secondaryConfig} />
        </div>
        <div class="min-w-0 flex-1">
          <Code code={secondaryCode} lang="html" />
        </div>
      </div>
    </>
  )}
</section>
