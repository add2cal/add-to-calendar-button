---
import { Code } from 'astro-expressive-code/components';
import type { DocsLocale } from '../docs-data';
import { guideCopy } from './copy';
interface Props { locale: DocsLocale }
const { locale } = Astro.props;
const c = guideCopy[locale];
---

<h2>
  {c.step} 2: {c.import}
</h2>
<p>{c.importText}</p>
<Code lang="javascript" code={`import 'add-to-calendar-button';`} />
