---
import { Code } from 'astro-expressive-code/components';
import type { DocsLocale } from '../docs-data';
import { guideCopy } from './copy';

interface Props { locale: DocsLocale; cdn?: boolean }
const { locale, cdn = false } = Astro.props;
const c = guideCopy[locale];
---

<h2>{c.styles}</h2>
<p>{c.stylesDefault}</p>
<p class="pt-5">{c.stylesOnDemand}</p>
<h3>{cdn ? c.stylesCdnHeading : c.stylesNpmHeading}</h3>
<p>{cdn ? c.stylesCdnBody : c.stylesNpmBody}</p>
{!cdn && <Code lang="javascript" code={`import 'add-to-calendar-button/styles/3d';   // any style besides "default"\nimport 'add-to-calendar-button/i18n/de';       // any language besides English\nimport 'add-to-calendar-button';             // load the component last`} />}
{!cdn && <p class="pt-5">{c.stylesAll}</p>}
<p class="mt-10">{c.stylesMore}</p>
