---
import type { AddToCalendarButtonType } from 'add-to-calendar-button';
import { Code } from 'astro-expressive-code/components';
import CalendarDemo from './calendar-demo.astro';
import { pathFor, type DocsLocale } from './docs-data';
import { getAdvancedContent } from './advanced/content';
import Interstitial from './advanced/interstitial.astro';
import { useTranslations } from '@utils/i18n';

interface Props {
  locale: DocsLocale;
}

const { locale } = Astro.props;
const content = getAdvancedContent(locale, pathFor('examples', locale), pathFor('configuration', locale));
const t = useTranslations(locale);
const sections = Array.from({ length: 12 }, (_, index) => ({ long: t(`docs.advanced.sections.${index + 1}.title`), short: t(`docs.advanced.sections.${index + 1}.short`) }));
const { demo } = content;
const today = new Date();
const nextDay = new Date(today);
nextDay.setDate(today.getDate() + 3);
const defaultDate = `${nextDay.getFullYear()}-${String(nextDay.getMonth() + 1).padStart(2, '0')}-${String(nextDay.getDate()).padStart(2, '0')}`;
const languageAttribute = locale === 'en' ? '' : `\n  language="${locale}"`;
const languageProperty = locale === 'en' ? '' : `,\n    language: "${locale}"`;
const options = ['Apple', 'Google', 'iCal'] as AddToCalendarButtonType['options'];
const allOptions = ['Apple', 'Google', 'iCal', 'Outlook.com', 'Microsoft365', 'MicrosoftTeams', 'Yahoo'] as AddToCalendarButtonType['options'];
const base = { name: demo.name, startDate: defaultDate, options, lightMode: 'bodyScheme', language: locale } satisfies AddToCalendarButtonType;
const markup = (attributes: string) => `<add-to-calendar-button\n${attributes}${languageAttribute}\n></add-to-calendar-button>`;
const cssParts = ['atcb-button-wrapper', 'atcb-button', 'atcb-button-icon', 'atcb-button-text', 'atcb-list-wrapper', 'atcb-list', 'atcb-list-item', 'atcb-list-item-close', 'atcb-list-icon', 'atcb-list-text', 'atcb-modal-box'];
const trackingEvents = ['initialization', 'openList', 'closeList', 'openCalendarLink', 'openSingletonLink', 'openSubEventLink', 'success'];
const sectionOneExamples: Array<{ config: AddToCalendarButtonType; code: string }> = [
  {
    config: { ...base, listStyle: 'overlay', buttonStyle: 'round', hideIconButton: true, hideBackground: true, label: demo.customOptionLabel },
    code: markup(`  name="${demo.name}"\n  start-date="${defaultDate}"\n  options="'apple','google','ical'"\n  button-style="round"\n  hide-icon-button\n  hide-background\n  label="${demo.customOptionLabel}"\n  light-mode="bodyScheme"`),
  },
  {
    config: { ...base, buttonStyle: 'flat', hideIconList: true, buttonsList: true, hideBackground: true, label: demo.nameCustom3 },
    code: markup(`  name="${demo.name}"\n  start-date="${defaultDate}"\n  options="'apple','google','ical'"\n  button-style="flat"\n  hide-icon-list\n  buttons-list\n  hide-background\n  label="${demo.nameCustom3}"\n  light-mode="bodyScheme"`),
  },
  {
    config: { ...base, name: demo.nameCustom4, startTime: '10:10', endTime: '10:40', timeZone: demo.timezone, location: 'Fantasy Marketplace', buttonStyle: 'date', size: '5' },
    code: markup(`  name="${demo.nameCustom4}"\n  start-date="${defaultDate}"\n  options="'apple','google','ical'"\n  start-time="10:10"\n  end-time="10:40"\n  time-zone="${demo.timezone}"\n  location="Fantasy Marketplace"\n  button-style="date"\n  size="5"\n  light-mode="bodyScheme"`),
  },
];
const overrideExample = {
  config: { ...base, styleLight: "--btn-background: #2f4377; --btn-text: #fff; --font: Georgia, 'Times New Roman', Times, serif;", styleDark: '--btn-background: #000;', hideIconButton: true },
  code: markup(`  style-light="--btn-background: #2f4377; --btn-text: #fff; --font: Georgia, 'Times New Roman', Times, serif;"\n  style-dark="--btn-background: #000;"\n  name="${demo.name}"\n  start-date="${defaultDate}"\n  options="'apple','google','ical'"\n  hide-icon-button\n  light-mode="bodyScheme"`),
};
const externalCssExample: { config: AddToCalendarButtonType; code: string } = {
  config: { ...base, customCss: 'https://add-to-calendar-button.com/atcb.css', buttonStyle: 'custom', listStyle: 'modal' },
  code: markup(`  name="${demo.name}"\n  start-date="${defaultDate}"\n  options="'apple','google','ical'"\n  light-mode="bodyScheme"\n  custom-css="https://add-to-calendar-button.com/atcb.css"\n  button-style="custom"\n  list-style="modal"`),
};
const partCode = `${markup(`  id="css-part-example"\n  name="${demo.name}"\n  start-date="${defaultDate}"\n  options="'apple','google','ical'"\n  light-mode="bodyScheme"`)}

<style>
  add-to-calendar-button#css-part-example::part(atcb-button),
  #atcb-btn-css-part-example-modal-host::part(atcb-button),
  #css-part-example::part(atcb-list),
  #atcb-btn-css-part-example-modal-host::part(atcb-list) {
    background-color: #264f3c;
    color: #fff;
  }
  /* or, for all buttons and modals:
  .add-to-calendar::part(atcb-button) {
    background-color: #264f3c;
    color: #fff;
  }
  */
</style>`;
const descriptionCode = markup(`  name="${demo.name}"\n  start-date="${defaultDate}"\n  start-time="10:15"\n  end-time="23:30"\n  time-zone="${demo.timezone}"\n  options="'apple','google','ical','outlookcom','ms365','msteams','yahoo'"\n  light-mode="bodyScheme"\n  description="${demo.description2}"`);
const subscriptionCode = markup(`  name="${demo.nameSubscription}"\n  subscribe\n  ics-file="https://add2cal.github.io/ics-demo/demo-calendar.ics"\n  options="'apple','google','ical','outlookcom','ms365','msteams','yahoo'"\n  light-mode="bodyScheme"`);
const customLabelsJson = JSON.stringify(demo.customLabels);
const labelsCode = markup(`  name="${demo.name}"\n  start-date="${defaultDate}"\n  start-time="10:15"\n  end-time="23:30"\n  label="${demo.nameCustom1}"\n  options="'apple','google','ical','outlookcom','yahoo'"\n  list-style="modal"\n  customLabels='${customLabelsJson}'\n  light-mode="bodyScheme"`);
const iCalCode = (label: string, sequence: number, updated: string, status: 'confirmed' | 'cancelled', fileName: string) => markup(`  name="${demo.name}"\n  start-date="${defaultDate}"\n  start-time="10:15"\n  end-time="23:30"\n  time-zone="${demo.timezone}"\n  label="${label}"\n  description="${demo.description3}"\n  options="ical"\n  organizer="${demo.organizer}"\n  uid="7060df05-7b3d-4baa-b215-689b85769e5b"\n  sequence="${sequence}"\n  ics-created="20221201T103000Z"\n  ics-updated="${updated}"\n  status="${status}"\n  ical-file-name="${fileName}"\n  light-mode="bodyScheme"`);
const identifierCode = markup(`  name="${demo.name}"\n  start-date="${defaultDate}"\n  start-time="10:15"\n  end-time="23:30"\n  time-zone="${demo.timezone}"\n  options="'apple','google','ical','outlookcom','ms365','msteams','yahoo'"\n  identifier="my-custom-id"\n  light-mode="bodyScheme"`);
const timezoneCode = markup(`  name="${demo.name}"\n  start-date="${defaultDate}"\n  start-time="10:00"\n  end-time="11:00"\n  time-zone="currentBrowser"\n  location="${demo.location}"\n  description="${demo.description1}"\n  options="'apple','google','ical'"\n  light-mode="bodyScheme"`);
const webviewCode = markup(`  name="${demo.nameDummy}"\n  start-date="${defaultDate}"\n  start-time="10:15"\n  end-time="23:30"\n  options="ical"\n  ics-file="https://add-to-calendar-button.com/demo-event.ics"\n  bypass-web-view-check\n  light-mode="bodyScheme"`);
const actionCode = `<button id="my-default-button">${t('docs.advanced.click')}</button>

<script type="application/javascript">
  const config = {
    name: "${demo.name}",
    description: "${demo.description1}",
    startDate: "${defaultDate}",
    startTime: "10:15",
    endTime: "23:30",
    options: ["google", "ical"],
    timeZone: "${demo.timezone}"${languageProperty}
  };
  const button = document.getElementById('my-default-button');
  if (button) {
    button.addEventListener('click', () => atcb_action(config, button));
  }
</script>`;
const actionConfig = JSON.stringify({ name: demo.name, description: demo.description1, startDate: defaultDate, startTime: '10:15', endTime: '23:30', options: ['Google', 'iCal'], timeZone: demo.timezone, lightMode: 'bodyScheme', language: locale });
const loadingCode = `import 'add-to-calendar-button'; // ${locale === 'de' ? 'Kern + Default-Style + Englisch' : locale === 'fr' ? 'cœur + style par défaut + anglais' : locale === 'es' ? 'núcleo + estilo predeterminado + inglés' : 'core + default style + English'}
import 'add-to-calendar-button/styles/3d'; // ${locale === 'de' ? 'deine Styles' : locale === 'fr' ? 'les styles utilisés' : locale === 'es' ? 'los estilos que usas' : 'the styles you use'}
import 'add-to-calendar-button/i18n/de'; // ${locale === 'de' ? 'deine Sprachen' : locale === 'fr' ? 'les langues proposées' : locale === 'es' ? 'los idiomas que ofreces' : 'the languages you serve'}`;
const ssrCode = `import { atcb_generate_ssr_html } from 'add-to-calendar-button/ssr';

const html = atcb_generate_ssr_html({
  name: 'Launch Party',
  startDate: '2050-06-15',
  buttonStyle: '3d',
  language: 'de',
});
// ${locale === 'de' ? 'füge den zurückgegebenen String in deine server-gerenderte Seite ein' : locale === 'fr' ? 'insérez la chaîne renvoyée dans votre page rendue par le serveur' : locale === 'es' ? 'inserta la cadena devuelta en la página renderizada por el servidor' : 'drop the returned string into your server-rendered page'}`;
---

<div class="flex flex-col lg:flex-row">
  <article class="advanced-content min-w-0 flex-1 pr-0 lg:pr-8 xl:pr-12 2xl:pr-20">
    <h1 class="mb-16 text-left text-5xl underline decoration-primary-light decoration-4 underline-offset-8 md:text-6xl dark:decoration-primary-dark">{t('docs.advanced.title')}</h1>
    <p set:html={content.intro[0]} />
    <p class="italic">{content.warning}</p>
    <p set:html={content.intro[1]} />

    <section id="case-1">
      <h2>1. {sections[0].long}</h2>
      <h3>{t('docs.advanced.headings.built-in')}</h3>
      {content.text.builtIn.map((paragraph) => (
        <p set:html={paragraph} />
      ))}
      {sectionOneExamples.map((example) => (
        <div class="example-row">
          <div class="demo">
            <CalendarDemo config={example.config} />
          </div>
          <div class="min-w-0 overflow-x-auto">
            <Code code={example.code} lang="html" />
          </div>
        </div>
      ))}

      <h3>{t('docs.advanced.headings.override')}</h3>
      {content.text.override.map((paragraph, index) => (
        <p class:list={{ italic: index === 2 }} set:html={paragraph} />
      ))}
      <div class="example-row">
        <div class="demo">
          <CalendarDemo config={overrideExample.config} />
        </div>
        <div class="min-w-0 overflow-x-auto">
          <Code code={overrideExample.code} lang="html" />
        </div>
      </div>

      <h3>{t('docs.advanced.headings.external-css')}</h3>
      {content.text.externalCss.map((paragraph) => (
        <p set:html={paragraph} />
      ))}
      <div class="example-row">
        <div class="demo">
          <CalendarDemo config={externalCssExample.config} />
        </div>
        <div class="min-w-0 overflow-x-auto">
          <Code code={externalCssExample.code} lang="html" />
        </div>
      </div>

      <h3>{t('docs.advanced.headings.part')}</h3>
      {content.text.part.map((paragraph) => (
        <p set:html={paragraph} />
      ))}
      <ul>
        {cssParts.map((part) => (
          <li>{part}</li>
        ))}
      </ul>
      <div class="example-row">
        <div class="demo">
          <add-to-calendar-button id="css-part-example" identifier="css-part-example" name={demo.name} start-date={defaultDate} options="'apple','google','ical'" light-mode="bodyScheme" language={locale} hide-rich-data hide-branding></add-to-calendar-button>
        </div>
        <div class="min-w-0 overflow-x-auto">
          <Code code={partCode} lang="html" />
        </div>
      </div>

      <h3>{t('docs.advanced.headings.custom-object')}</h3>
      {content.text.customObject.map((paragraph) => (
        <p set:html={paragraph} />
      ))}
    </section>

    <section id="case-2">
      <h2>2. {sections[1].long}</h2>
      {content.text.s2.map((paragraph) => (
        <p set:html={paragraph} />
      ))}
      <p class="mt-6">
        <strong>{t('docs.advanced.supported-tags')}:</strong>
      </p>
      <ul class="text-sm">
        <li>[hr]</li>
        <li>[p] ... [/p]</li>
        <li>[br]</li>
        <li>[strong] ... [/strong]</li>
        <li>[u] ... [/u]</li>
        <li>[i] ... [/i], [em] ... [/em]</li>
        <li>[ul] ... [/ul], [ol] ... [/ol], [li] ... [/li]</li>
        <li>[h*] ... [/h*] (← h1, h2, h3, ...)</li>
        <li>
          [url] ... [/url]
          <br />
          <span class="italic">{content.labels.url}</span>
        </li>
      </ul>
      <div class="example-row">
        <div class="demo">
          <CalendarDemo config={{ ...base, startTime: '10:15', endTime: '23:30', timeZone: demo.timezone, options: allOptions, description: demo.description2 }} />
        </div>
        <div class="min-w-0 overflow-x-auto">
          <Code code={descriptionCode} lang="html" />
        </div>
      </div>
    </section>

    <section id="case-3">
      <h2>3. {sections[2].long}</h2>
      {content.text.s3.map((paragraph) => (
        <p set:html={paragraph} />
      ))}
      <div class="example-row">
        <div class="demo">
          <CalendarDemo config={{ name: demo.nameSubscription, subscribe: true, icsFile: 'https://add2cal.github.io/ics-demo/demo-calendar.ics', options: allOptions, lightMode: 'bodyScheme', language: locale }} />
        </div>
        <div class="min-w-0 overflow-x-auto">
          <Code code={subscriptionCode} lang="html" />
        </div>
      </div>
    </section>

    <section id="case-4">
      <h2>4. {sections[3].long}</h2>
      {content.text.s4.map((paragraph) => (
        <p set:html={paragraph} />
      ))}
      <div class="example-row">
        <div class="demo">
          <CalendarDemo config={{ ...base, startTime: '10:15', endTime: '23:30', label: demo.nameCustom1, options: ['Apple', 'Google', 'iCal', 'Outlook.com', 'Yahoo'], listStyle: 'modal', customLabels: demo.customLabels }} />
        </div>
        <div class="min-w-0 overflow-x-auto">
          <Code code={labelsCode} lang="html" />
        </div>
      </div>
    </section>

    <section id="case-5">
      <h2>5. {sections[4].long}</h2>
      {content.text.s5.map((paragraph) => (
        <p set:html={paragraph} />
      ))}
      <div class="example-row">
        <div class="demo flex-col text-center">
          <div class="mb-5 text-sm font-semibold">A. {content.labels.addExample}</div>
          <CalendarDemo config={{ ...base, startTime: '10:15', endTime: '23:30', timeZone: demo.timezone, label: demo.add, description: demo.description3, options: ['iCal'], organizer: demo.organizer, uid: '7060df05-7b3d-4baa-b215-689b85769e5b', sequence: 1, icsCreated: '20221201T103000Z', icsUpdated: '20221205T154500Z', status: 'confirmed', iCalFileName: demo.confirmedFile, debug: true }} />
        </div>
        <div class="min-w-0 overflow-x-auto">
          <Code code={iCalCode(demo.add, 1, '20221205T154500Z', 'confirmed', demo.confirmedFile)} lang="html" />
        </div>
      </div>
      <div class="example-row">
        <div class="demo flex-col text-center">
          <div class="mb-5 text-sm font-semibold">B. {content.labels.cancelExample}</div>
          <CalendarDemo config={{ ...base, startTime: '10:15', endTime: '23:30', timeZone: demo.timezone, label: demo.cancel, description: demo.description3, options: ['iCal'], organizer: demo.organizer, uid: '7060df05-7b3d-4baa-b215-689b85769e5b', sequence: 3, icsCreated: '20221201T103000Z', icsUpdated: '20221218T154500Z', status: 'cancelled', iCalFileName: demo.cancelledFile, debug: true }} />
        </div>
        <div class="min-w-0 overflow-x-auto">
          <Code code={iCalCode(demo.cancel, 2, '20221218T154500Z', 'cancelled', demo.cancelledFile)} lang="html" />
        </div>
      </div>
    </section>

    <Interstitial {locale} question={t('docs.advanced.pro-question')} action={t('docs.advanced.pro-action')} imageAlt={t('docs.advanced.pro-image-alt')} />

    <section id="case-6">
      <h2>6. {sections[5].long}</h2>
      {content.text.s6.map((paragraph) => (
        <p set:html={paragraph} />
      ))}
      <div class="example-row">
        <div class="demo">
          <CalendarDemo config={{ ...base, startTime: '10:15', endTime: '23:30', timeZone: demo.timezone, options: allOptions, identifier: 'my-custom-id' }} />
        </div>
        <div class="min-w-0 overflow-x-auto">
          <Code code={identifierCode} lang="html" />
        </div>
      </div>
    </section>

    <section id="case-7">
      <h2>7. {sections[6].long}</h2>
      <p set:html={content.text.s7[0]} />
      <ol>
        <li set:html={content.labels.trackingOne} />
        <li set:html={content.labels.trackingTwo} />
      </ol>
      <p set:html={content.text.s7[1]} />
      <p class="mt-6 font-semibold">{t('docs.advanced.available-events')}:</p>
      <ul class="text-sm">
        {trackingEvents.map((event) => (
          <li>{event}</li>
        ))}
      </ul>
      <p class="text-sm italic">({content.labels.trackingDisclaimer})</p>
    </section>

    <section id="case-8">
      <h2>8. {sections[7].long}</h2>
      {content.text.s8.map((paragraph) => (
        <p set:html={paragraph} />
      ))}
      <div class="example-row">
        <div class="demo">
          <CalendarDemo config={{ ...base, startTime: '10:00', endTime: '11:00', timeZone: 'currentBrowser', location: demo.location, description: demo.description1 }} />
        </div>
        <div class="min-w-0 overflow-x-auto">
          <Code code={timezoneCode} lang="html" />
        </div>
      </div>
    </section>

    <section id="case-9">
      <h2>9. {sections[8].long}</h2>
      {content.text.s9.slice(0, 4).map((paragraph) => (
        <p set:html={paragraph} />
      ))}
      <ul>
        <li>{content.labels.webviewOne}</li>
        <li>{content.labels.webviewTwo}</li>
        <li>{content.labels.webviewThree}</li>
      </ul>
      <p set:html={content.text.s9[4]} />
      <div class="example-row">
        <div class="demo">
          <CalendarDemo config={{ ...base, name: demo.nameDummy, startTime: '10:15', endTime: '23:30', options: ['iCal'], icsFile: 'https://add-to-calendar-button.com/demo-event.ics', bypassWebViewCheck: true }} />
        </div>
        <div class="min-w-0 overflow-x-auto">
          <Code code={webviewCode} lang="html" />
        </div>
      </div>
    </section>

    <section id="case-10">
      <h2>10. {sections[9].long}</h2>
      {content.text.s10.map((paragraph) => (
        <p set:html={paragraph} />
      ))}
      <h3>{t('docs.advanced.headings.import')}</h3>
      {content.text.import.map((paragraph) => (
        <p set:html={paragraph} />
      ))}
      <Code code={`import { atcb_action } from "add-to-calendar-button";`} lang="javascript" />
      <h3>{t('docs.advanced.headings.trigger')}</h3>
      {content.text.trigger.map((paragraph) => (
        <p set:html={paragraph} />
      ))}
      <div class="example-row">
        <div class="demo">
          <button id="my-default-button" data-config={actionConfig} class="border-secondary bg-secondary hover:bg-secondary-light h-fit rounded-full border-2 px-4 py-2 text-zinc-800 hover:text-black hover:shadow-lg">
            {t('docs.advanced.click')}
          </button>
        </div>
        <div class="min-w-0 overflow-x-auto">
          <Code code={actionCode} lang="html" />
        </div>
      </div>
    </section>

    <section id="case-11">
      <h2>11. {sections[10].long}</h2>
      <p set:html={content.text.s11[0]} />
      <p set:html={content.text.s11[1]} />
      <ol>
        <li set:html={content.labels.loadingOne} />
      </ol>
      <Code code={loadingCode} lang="javascript" />
      <p set:html={content.text.s11[2]} />
      <ol start="2">
        <li set:html={content.labels.loadingTwo} />
        <li set:html={content.labels.loadingThree} />
      </ol>
    </section>

    <section id="case-12">
      <h2>12. {sections[11].long}</h2>
      <p set:html={content.text.s12[0]} />
      <Code code={ssrCode} lang="javascript" />
      <p set:html={content.text.s12[1]} />
      <Code code={`import 'add-to-calendar-button/styles/3d';\nimport 'add-to-calendar-button/i18n/de';\nimport 'add-to-calendar-button';`} lang="javascript" />
      <p set:html={content.text.s12[2]} />
      <Code code={`import { atcb_generate_ssr_html_async } from 'add-to-calendar-button/ssr';\n\nconst html = await atcb_generate_ssr_html_async({\n  proKey: 'YOUR_PRO_KEY',\n});`} lang="javascript" />
      <p set:html={content.text.s12[3]} />
      <p class="italic" set:html={content.text.s12[4]} />
    </section>
  </article>

  <aside class="hidden w-48 shrink-0 border-l border-zinc-300 pl-8 text-sm dark:border-zinc-700 lg:block">
    <nav class="sticky top-0 pt-4" aria-label={t('docs.common.on-this-page')}>
      {sections.map((section, index) => (
        <a href={`#case-${index + 1}`} class="decoration-secondary my-4 block no-underline underline-offset-4 hover:underline">
          #{index + 1}: {section.short}
        </a>
      ))}
    </nav>
  </aside>
</div>

<script>
  const initializeAdvancedAction = () => {
    const button = document.querySelector<HTMLButtonElement>('#my-default-button');
    if (!button || button.dataset.ready === 'true' || !button.dataset.config) return;
    button.dataset.ready = 'true';
    button.addEventListener('click', async () => {
      const { atcb_action } = await import('add-to-calendar-button');
      atcb_action(JSON.parse(button.dataset.config || '{}'), button);
    });
  };

  initializeAdvancedAction();
  document.addEventListener('astro:page-load', initializeAdvancedAction);
</script>

<style>
  .advanced-content :global(p) {
    margin-block: 1rem;
    line-height: 1.7;
  }
  .advanced-content :global(h2) {
    margin-top: 3.5rem;
    margin-bottom: 1rem;
    border-top: 1px solid rgb(212 212 216);
    padding-top: 3.5rem;
    font-size: 1.75rem;
    font-weight: 700;
  }
  .advanced-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .advanced-content :global(ul),
  .advanced-content :global(ol) {
    margin: 0.75rem 0 1rem 1.5rem;
  }
  .advanced-content :global(ul) {
    list-style: disc;
  }
  .advanced-content :global(ol) {
    list-style: decimal;
  }
  .advanced-content :global(li) {
    margin-block: 0.4rem;
