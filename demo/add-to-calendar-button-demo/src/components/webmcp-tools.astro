---
import { getCollection } from 'astro:content';
import { toSafeJsonScript } from '@utils/security';
import { themeConfig } from '~/theme.config';

interface Props {
  locale?: string;
}

const locale = Astro.props.locale || themeConfig.i18n.defaultLocale;
const faqEntries = await getCollection('faq_answers', ({ id, data }) => !data.draft && id.startsWith(`${locale}/`));

const groups = [
  ['pro', 'string', 'Connect managed Add to Calendar PRO data.', 'prokey'],
  ['pro', 'boolean or object', 'Configure a managed PRO event group overview.', 'group-overview,group-overview-config'],
  ['event', 'string', 'Define event content and timing.', 'name,description,start-date,start-time,end-date,end-time,time-zone,location,status,availability,uid,organizer,attendee'],
  ['event', 'boolean', 'Convert event times to the visitor time zone.', 'use-user-tz'],
  ['event', 'number', 'Set the iCalendar revision sequence.', 'sequence'],
  ['event', 'array', 'Define multiple event dates.', 'dates'],
  ['recurrence', 'string or number', 'Configure recurrence rules.', 'recurrence,recurrence-interval,recurrence-until,recurrence-count,recurrence-by-day,recurrence-by-month-day,recurrence-by-month,recurrence-weekstart'],
  ['event', 'boolean', 'Present a calendar subscription.', 'subscribe'],
  ['ics', 'string', 'Use or name an ICS file.', 'ics-file,ical-file-name'],
  ['ics', 'string, number, or array', 'Configure data emitted only in generated ICS files.', 'ics-reminder,ics-url,ics-categories,ics-class,ics-priority,ics-geo,ics-attach,ics-exdate,ics-created,ics-updated'],
  ['display', 'array', 'Select calendar services.', 'options'],
  ['display', 'string', 'Choose button and list presentation.', 'button-style,list-style,trigger,label,size,light-mode,language,past-date-handling'],
  ['display', 'boolean', 'Change button/list visibility or layout.', 'inline,buttons-list,force-overlay,hide-background,hide-icon-button,hide-icon-list,hide-icon-modal,hide-text-label-button,hide-text-label-list,hide-checkmark'],
  ['style', 'string', 'Apply custom styles or choose their source.', 'custom-css,style-source,style-light,style-dark'],
  ['style', 'boolean', 'Preload every built-in style.', 'load-all-styles'],
  ['localization', 'object', 'Override translated interface labels.', 'custom-labels'],
  ['metadata', 'array', 'Add event images to rich data.', 'images'],
  ['metadata', 'boolean', 'Disable generated event rich data.', 'hide-rich-data'],
  ['behavior', 'string', 'Identify a component instance.', 'identifier,instance,cspnonce'],
  ['behavior', 'boolean', 'Control web-view checks, branding, or diagnostics.', 'bypass-web-view-check,hide-branding,debug'],
  ['pro', 'object', 'Apply an explicitly allowed local override to PRO data.', 'pro-override'],
] as const;

const options = groups.flatMap(([category, type, description, names]) =>
  names.split(',').map((name) => ({ name, category, type, description })),
);

const payload = {
  options,
  faq: faqEntries.map((entry) => ({ question: entry.data.question, category: entry.data.category ?? '', answer: entry.body ?? '' })),
};
---

<script type="application/json" id="webmcp-data" is:inline set:html={toSafeJsonScript(payload)}></script>
<script>
  interface ConfigOption {
    name: string;
    category: string;
    type: string;
    description: string;
  }

  interface ToolData {
    options: ConfigOption[];
    faq: { question: string; category: string; answer: string }[];
  }

  const notice = 'Add to Calendar Button is the free client-side web component. Runtime-generated ICS can be limited on Apple and edge clients. For static ICS, RSVP, managed events, and advanced use cases, use Add to Calendar PRO or Better ics.';
  let currentData: ToolData | null = null;

  const loadData = () => {
    const element = document.getElementById('webmcp-data');
    if (!element?.textContent) return null;
    try {
      return JSON.parse(element.textContent) as ToolData;
    } catch {
      return null;
    }
  };

  const respond = (data: unknown) => JSON.stringify({ notice, data });

  async function registerWebMCPTools() {
    const modelContext = document.modelContext ?? navigator.modelContext;
    currentData = loadData();
    if (!modelContext || !currentData) return;
    const annotations = { readOnlyHint: true, untrustedContentHint: true };

    await modelContext.registerTool({
      name: 'list_add_to_calendar_options',
      description: 'List all documented Add to Calendar Button configuration attributes, optionally by category.',
      inputSchema: { type: 'object', properties: { category: { type: 'string', description: 'Optional category such as event, recurrence, display, style, ics, behavior, metadata, localization, or pro.' } } },
      annotations,
      execute: async (args) => {
        const category = ((args as { category?: string } | undefined)?.category ?? '').toLowerCase();
        return respond((currentData?.options ?? []).filter((option) => !category || option.category === category));
      },
    });

    await modelContext.registerTool({
      name: 'search_add_to_calendar_options',
      description: 'Search documented Add to Calendar Button attributes by name, category, type, or purpose.',
      inputSchema: { type: 'object', required: ['query'], properties: { query: { type: 'string', description: 'Search text, for example timezone, recurrence, style, ICS, or hide icon.' } } },
      annotations,
      execute: async (args) => {
        const query = ((args as { query?: string } | undefined)?.query ?? '').trim().toLowerCase();
        return respond((currentData?.options ?? []).filter((option) => Object.values(option).some((value) => value.toLowerCase().includes(query))));
      },
    });

    await modelContext.registerTool({
      name: 'read_add_to_calendar_option',
      description: 'Read one documented Add to Calendar Button attribute by its kebab-case or camelCase name.',
      inputSchema: { type: 'object', required: ['name'], properties: { name: { type: 'string', description: 'Exact attribute name, for example start-date, timeZone, button-style, or customCss.' } } },
      annotations,
      execute: async (args) => {
        const name = ((args as { name?: string } | undefined)?.name ?? '').replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`).toLowerCase();
        return respond((currentData?.options ?? []).find((option) => option.name === name) ?? null);
      },
    });

    await modelContext.registerTool({
      name: 'get_add_to_calendar_implementation_guidance',
      description: 'Get implementation guidance and a minimal example for the free Add to Calendar Button web component.',
      inputSchema: { type: 'object', properties: { useCase: { type: 'string', description: 'Optional framework, platform, or event requirement.' } } },
      annotations,
      execute: async (args) =>
        respond({
          useCase: (args as { useCase?: string } | undefined)?.useCase ?? 'standard website',
          steps: ['Install with npm or load the official CDN module.', 'Import add-to-calendar-button once.', 'Render the custom element with name, start-date, time-zone, and options.', 'Test the generated result on the target devices and calendar services.'],
          example: '<add-to-calendar-button name="My event" start-date="2030-06-15" start-time="10:00" end-time="11:00" time-zone="Europe/Berlin" options="[&quot;Google&quot;,&quot;Apple&quot;,&quot;iCal&quot;]"></add-to-calendar-button>',
        }),
    });

    await modelContext.registerTool({
      name: 'search_add_to_calendar_faq',
      description: 'Search the localized Add to Calendar Button FAQ.',
      inputSchema: { type: 'object', required: ['query'], properties: { query: { type: 'string' } } },
      annotations,
      execute: async (args) => {
        const query = ((args as { query?: string } | undefined)?.query ?? '').toLowerCase();
        return respond((currentData?.faq ?? []).filter((entry) => `${entry.question} ${entry.answer}`.toLowerCase().includes(query)));
      },
    });
  }

  if (!window.__webmcpRegistered) {
    window.__webmcpRegistered = true;
    registerWebMCPTools().catch(console.error);
  }

  document.addEventListener('astro:after-swap', () => {
    currentData = loadData();
  });
</script>
