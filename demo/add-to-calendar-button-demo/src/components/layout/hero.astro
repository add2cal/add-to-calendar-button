---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import combo from '@images/combo.webp';
import Stats from '@components/home/stats.astro';
import HeroChip from '@components/promo/hero-chip.astro';
import { themeConfig } from '~/theme.config';
import { useTranslations } from '@utils/i18n';

interface Props { locale: string }
const { locale: requestedLocale = 'en' } = Astro.props;
const locale = ['en', 'de', 'fr', 'es'].includes(requestedLocale) ? requestedLocale as 'en' | 'de' | 'fr' | 'es' : 'en';
const t = useTranslations(locale);
---

<section class="hero relative overflow-hidden bg-linear-to-tr from-primary-darkest via-primary-dark to-primary pt-36 pb-24 text-white shadow-2xl md:pt-44 md:pb-28">
  <div class="pointer-events-none absolute inset-0 opacity-20" aria-hidden="true"></div>
  <div class="container relative mx-auto grid items-center gap-12 lg:grid-cols-2">
    <div class="max-w-xl">
      {themeConfig.promotions?.heroChip && (
        <div class="mb-5 w-fit">
          <HeroChip {locale} />
        </div>
      )}
      <p class="mb-3 text-sm font-bold tracking-[.2em] uppercase text-primary-light">{t('pages.home.hero.prefix')}</p>
      <h1 class="text-5xl leading-[1.05] text-white drop-shadow-lg md:text-7xl">Add to Calendar Button</h1>
      <p class="mt-6 text-2xl font-semibold italic text-white/75 md:text-3xl">{t('pages.home.hero.slogan')}</p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="#installation" class="btn-outline border-white text-white">
          {t('pages.home.hero.start')}
        </a>
        <a href="#demo" class="btn-primary">
          {t('pages.home.hero.demo')}
          <Icon name="heroicons:arrow-down" class="size-4" />
        </a>
      </div>
    </div>
    <Image src={combo} alt={t('pages.home.hero.image-alt')} widths={[500, 978]} sizes="(min-width: 976px) 48vw, 90vw" class="mx-auto w-full max-w-2xl drop-shadow-2xl" loading="eager" />
  </div>
</section>

<Stats {locale} />

<style>
  .hero > div:first-child {
    background-image: radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.7) 0 1px, transparent 2px), radial-gradient(circle at 70% 60%, rgba(255, 255, 255, 0.5) 0 1px, transparent 2px);
    background-size:
      70px 70px,
      110px 110px;
  }
</style>
