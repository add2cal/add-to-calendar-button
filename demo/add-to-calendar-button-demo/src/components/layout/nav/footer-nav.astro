---
import { useTranslations, getLocaleUrl } from "@utils/i18n";

interface Props {
  locale: string;
  isHome?: boolean;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);
---

<nav role="navigation" aria-label={t('footer.navigation-label')} class="xs:grid-cols-2 xs:justify-items-start grid w-full grid-cols-1 justify-items-center gap-14 text-left text-sm sm:grid-cols-3 md:w-auto md:grid-cols-2 lg:grid-cols-3 xl:gap-20">
  <div class="group xs:items-start flex flex-col items-center">
    <h3>{t('labels.product')}</h3>
    <a class="unstyle-link w-fit pt-1.5 opacity-80 group-hover:opacity-60 hover:opacity-100" href={getLocaleUrl('/#demo', locale)}>
      {t('nav.demo')}
    </a>
    <a class="unstyle-link w-fit pt-1.5 opacity-80 group-hover:opacity-60 hover:opacity-100" href={getLocaleUrl('what-is-an-add-to-calendar-button', locale)}>
      {t('footer.definition')}
    </a>
    <a class="unstyle-link w-fit pt-1.5 opacity-80 group-hover:opacity-60 hover:opacity-100" href={getLocaleUrl('examples', locale)}>
      {t('footer.basic-examples')}
    </a>
    <a class="unstyle-link w-fit pt-1.5 opacity-80 group-hover:opacity-60 hover:opacity-100" href={getLocaleUrl('advanced-use', locale)}>
      {t('footer.advanced-examples')}
    </a>
  </div>
  <div class="group xs:items-start flex flex-col items-center">
    <h3>{t('labels.guides')}</h3>
    <a class="unstyle-link w-fit pt-1.5 opacity-80 group-hover:opacity-60 hover:opacity-100" href={getLocaleUrl('configuration', locale)}>
      {t('nav.docs-configuration')}
    </a>
    <a class="unstyle-link w-fit pt-1.5 opacity-80 group-hover:opacity-60 hover:opacity-100" href={getLocaleUrl('/#installation', locale)}>
      {t('nav.docs-installation')}
    </a>
    <a class="unstyle-link w-fit pt-1.5 opacity-80 group-hover:opacity-60 hover:opacity-100" href={getLocaleUrl('migration-guide-v2-to-v3', locale)}>
      {t('footer.migration-guide')}
    </a>
  </div>
  <div class="group xs:items-start flex flex-col items-center">
    <h3>{t('labels.resources')}</h3>
    <a class="unstyle-link external-link w-fit pt-1.5 opacity-80 group-hover:opacity-60 hover:opacity-100" href="https://www.npmjs.com/package/add-to-calendar-button" target="_blank" rel="noopener">
      npm
    </a>
    <a class="unstyle-link w-fit pt-1.5 opacity-80 group-hover:opacity-60 hover:opacity-100" href={getLocaleUrl('faq', locale)}>
      {t('nav.faq')}
    </a>
    <a class="unstyle-link external-link w-fit pt-1.5 opacity-80 group-hover:opacity-60 hover:opacity-100" href="https://github.com/add2cal/add-to-calendar-button/discussions" target="_blank" rel="help noopener">
      {t('nav.help')}
    </a>
    <a class="unstyle-link external-link w-fit pt-1.5 opacity-80 group-hover:opacity-60 hover:opacity-100" href="https://github.com/add2cal/add-to-calendar-button" target="_blank" rel="noopener">
      GitHub
    </a>
  </div>
</nav>
