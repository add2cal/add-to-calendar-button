---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Playground from '@components/playground/PlaygroundArea.vue';
import { getLocaleUrl, useTranslations } from '@utils/i18n';
import accessibility from '@images/accessibility.webp';
import caltypes from '@images/caltypes.webp';
import more from '@images/more.webp';
import style from '@images/style.webp';
import variety from '@images/variety.webp';
import ProductHuntDark from '@images/ph-badge-dark.svg';
import ProductHuntLight from '@images/ph-badge-light.svg';

interface Props { locale?: 'en' | 'de' | 'fr' | 'es' }
const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const stacks = [
  ['Angular', 'logos:angular-icon', 'use-with-angular', 'angular'],
  ['Astro', 'logos:astro-icon', 'use-with-astro', 'astro'],
  ['Next.js', 'logos:nextjs-icon', 'use-with-nextjs', 'nextjs'],
  ['Nuxt', 'logos:nuxt-icon', 'use-with-nuxt', 'nuxt'],
  ['React', 'logos:react', 'use-with-react', 'react'],
  ['Svelte', 'logos:svelte-icon', 'use-with-svelte', 'svelte'],
  ['Vue', 'logos:vue', 'use-with-vue', 'vue'],
  ['Wix', 'logos:wix', 'use-with-wix', 'wix'],
  ['WordPress', 'logos:wordpress-icon', 'use-with-wordpress', 'wordpress'],
] as const;
const featureImages = [caltypes, variety, style, accessibility, more];
const featureGroups = [
  ['calendars', 5],
  ['events', 5],
  ['look', 3],
  ['accessibility', 5],
  ['more', 3],
] as const;
---

<div class="overflow-x-clip">
  <section class="container mx-auto grid gap-10 py-16 lg:grid-cols-[1fr_auto] lg:py-24">
    <div class="max-w-3xl">
      <h2 class="mb-8 text-3xl leading-tight text-stone-600 md:text-4xl dark:text-stone-300">{t('pages.home.intro.slogan')}</h2>
      {[1, 2, 3].map((item, index) => (
        <p class:list={['max-w-3xl leading-7', { 'font-semibold': index === 2 }]}>{t(`pages.home.intro.paragraph-${item}`)}</p>
      ))}
    </div>
    <a class="self-center lg:self-start" href="https://www.producthunt.com/posts/add-to-calendar-button-generator" target="_blank" rel="noopener">
      <ProductHuntLight class="block w-[250px] drop-shadow dark:hidden" aria-label={t('pages.home.intro.product-hunt-label')} />
      <ProductHuntDark class="hidden w-[250px] drop-shadow dark:block" aria-label={t('pages.home.intro.product-hunt-label')} />
    </a>
  </section>

  <section id="demo" class="scroll-mt-20 bg-linear-to-tr from-stone-300 to-stone-100 py-16 shadow-inner dark:from-stone-900 dark:to-stone-800" aria-labelledby="demo-heading">
    <div class="container mx-auto mb-8">
      <h2 id="demo-heading" class="section-heading">
        <Icon name="heroicons:beaker" />
        {t('pages.home.playground.heading')}
      </h2>
    </div>
    <Playground client:only="vue" {locale} themeSwitchLabel={t('labels.change-light-mode')}>
      <p slot="fallback" class="container mx-auto py-24 text-center">
        {t('pages.home.playground.loading')}
      </p>
    </Playground>
    <p class="container mx-auto mt-6 text-center text-sm italic text-stone-500">
      {t('pages.home.playground.disclaimer')} <a href={getLocaleUrl('configuration', locale)}>{t('pages.home.playground.configuration')}</a>
    </p>
  </section>

  <section id="installation" class="container mx-auto scroll-mt-20 py-24" aria-labelledby="installation-heading">
    <h2 id="installation-heading" class="section-heading">
      <Icon name="heroicons:wrench-screwdriver" />
      {t('pages.home.installation.heading')}
    </h2>
    <p class="mt-7 max-w-3xl leading-7">{t('pages.home.installation.intro')}</p>
    <p class="font-semibold">{t('pages.home.installation.prompt')}</p>
    <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {stacks.map(([name, icon, route, brand]) => (
        <a href={getLocaleUrl(route, locale)} class:list={['stack-card group', `stack-card--${brand}`]}>
          <Icon name={icon} class="size-10 transition-transform group-hover:scale-110" aria-hidden="true" />
          <span>{name}</span>
        </a>
      ))}
      <a href={getLocaleUrl('use', locale)} class="stack-card stack-card--javascript col-span-2 border-secondary sm:col-span-3 lg:col-span-1">
        <Icon name="heroicons:code-bracket" class="size-10" aria-hidden="true" />
        <span>JavaScript</span>
      </a>
    </div>
    <p class="mt-8 text-center text-stone-600 dark:text-stone-300">{t('pages.home.installation.other')}</p>
  </section>

  <section id="features" class="container mx-auto scroll-mt-20 pb-24" aria-labelledby="features-heading">
    <h2 id="features-heading" class="section-heading">
      <Icon name="heroicons:sparkles" />
      {t('pages.home.features.heading')}
    </h2>
    <p class="mt-7">{t('pages.home.features.intro')}</p>
    <div class="mx-auto mt-16 grid max-w-4xl gap-x-12 gap-y-16 md:grid-cols-[180px_1fr]">
      {featureGroups.map(([group, itemCount], index) => (
        <>
          <Image src={featureImages[index]} alt="" widths={[150, 300]} sizes="150px" class="mx-auto self-center" />
          <div class="self-center">
            <h3 class="mb-4 text-center text-2xl md:text-left">{t(`pages.home.features.${group}.heading`)}</h3>
            <ul class="list-disc space-y-2 pl-6">
              {Array.from({ length: itemCount }, (_, item) => (
                <li>{t(`pages.home.features.${group}.item-${item + 1}`)}</li>
              ))}
            </ul>
          </div>
        </>
      ))}
    </div>
  </section>

  <section class="border-y border-stone-300 bg-linear-to-tr from-stone-300 to-stone-100 py-16 text-center shadow dark:border-stone-700 dark:from-stone-900 dark:to-stone-800">
    <div class="container mx-auto">
      <h2 class="mb-8 text-3xl">{t('pages.home.next.heading')}</h2>
      <div class="flex flex-wrap justify-center gap-5">
        <a class="btn-primary" href={getLocaleUrl('examples', locale)}>
          {t('pages.home.next.examples')}
          <Icon name="heroicons:arrow-right" />
        </a>
        <a class="btn-primary" href={getLocaleUrl('configuration', locale)}>
          {t('pages.home.next.configure')}
          <Icon name="heroicons:arrow-right" />
        </a>
      </div>
    </div>
  </section>
</div>

<style>
  @reference '../../styles/tailwind.config.css';
  .section-heading {
    @apply decoration-primary-light dark:decoration-primary-dark flex items-center gap-3 text-3xl underline decoration-2 underline-offset-8 md:text-4xl;
  }
  .section-heading :global(svg) {
    @apply size-7 shrink-0;
  }
  .stack-card {
    @apply flex min-h-32 flex-col items-center justify-center gap-4 rounded-xl border-2 border-stone-300 bg-white p-4 text-center no-underline shadow-sm transition hover:-translate-y-1 hover:shadow-lg dark:border-stone-700 dark:bg-stone-800;
  }
  .stack-card--angular {
    @apply hover:border-angular hover:bg-angular hover:text-white;
  }
  .stack-card--astro {
    @apply hover:border-astro hover:bg-astro hover:text-white;
  }
  .stack-card--nextjs,
  .stack-card--wix {
    @apply hover:border-black hover:bg-black hover:text-white;
  }
  .stack-card--nuxt {
    @apply hover:border-nuxt hover:bg-nuxt hover:text-white;
  }
  .stack-card--react {
    @apply hover:border-react hover:bg-react hover:text-white;
  }
  .stack-card--svelte {
    @apply hover:border-svelte hover:bg-svelte hover:text-white;
  }
  .stack-card--vue {
    @apply hover:border-vue hover:bg-vue hover:text-white;
  }
  .stack-card--wordpress {
    @apply hover:border-wordpress hover:bg-wordpress hover:text-white;
  }
  .stack-card--javascript {
    @apply hover:border-javascript hover:bg-javascript hover:text-black;
  }
  :global(.stack-card:hover svg) {
    color: white !important;
  }
  :global(.stack-card:hover svg [fill]:not([fill='none'])) {
    fill: white !important;
  }
  :global(.stack-card:hover svg [stroke]:not([stroke='none'])) {
    stroke: white !important;
  }
</style>
