---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/default.astro";
import FaqList from "@components/faq/faq-list.astro";
import { useTranslations } from "@utils/i18n";
import '@styles/content-pages.css';
import { themeConfig } from '~/theme.config';

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);

const entries = (await getCollection('faq_answers', ({ id, data }) => {
  return !data.draft && id.startsWith(locale + '/');
}) as CollectionEntry<'faq_answers'>[]).sort((a, b) =>
  a.data.question.localeCompare(b.data.question, locale)
);

const items = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);

const categories = Array.from(
  new Set(entries.map((e) => e.data.category).filter(Boolean) as string[])
).sort((a, b) => a.localeCompare(b, locale));
---

<Layout {locale} title={t('pages.faq.title')} description={t('pages.faq.description')} schemaType="FAQPage" collection="faq_answers">
  <div class="mx-auto max-w-4xl">
    <header class="page-header">
      <p class="page-eyebrow">{t('nav.help')}</p>
      <h1 class="page-title">{t('pages.faq.title')}</h1>
    </header>
    <FaqList {locale} {items} {categories} />
  </div>
</Layout>
