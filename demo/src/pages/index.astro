---
import Layout from "@layouts/default.astro";
import HomeContent from "@components/home/home-content.astro";
import { themeConfig } from '~/theme.config';
import { useTranslations } from '@utils/i18n';

const locale = themeConfig.i18n.defaultLocale as 'en';
const t = useTranslations(locale);
---

<Layout isHome header={{ overlay: true, scrollDownThreshold: 700 }} title={t('pages.home.title')} description={t('pages.home.description')} noTitleSlug noContainer>
  <HomeContent {locale} />
</Layout>
