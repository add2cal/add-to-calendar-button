---
import { Icon } from 'astro-icon/components';

interface Props {
  kind: 'calendars' | 'events' | 'timezones' | 'browsers' | 'styling' | 'accessibility';
}

const { kind } = Astro.props;
const calendarLogos = ['logos:apple', 'logos:google-calendar', 'thesvg-color:microsoft-outlook', 'picon:yahoo', 'logos:microsoft-teams', 'heroicons:calendar-days', 'thesvg-color:microsoft'];
const logoLanes = [calendarLogos, [...calendarLogos].reverse()];
---

{kind === 'calendars' && (
  <div class="cap-graphic" aria-hidden="true">
    {logoLanes.map((logos) => (
      <div class="calendar-logo-lane text-black">
        {[...logos, ...logos].map((icon) => (
          <span class="calendar-logo-chip">
            <Icon name={icon} />
          </span>
        ))}
      </div>
    ))}
  </div>
)}

{kind === 'events' && (
  <div class="cap-graphic" aria-hidden="true">
    <div class="event-motion-calendar">
      <div class="event-motion-head">
        <span>M</span>
        <span>T</span>
        <span>W</span>
        <span>T</span>
        <span>F</span>
      </div>
      <div class="event-motion-grid">
        <span class="event-motion-mode">Single · multi · recurring</span>
        <span class="event-motion-bar"></span>
        <span class="event-motion-copy copy-a"></span>
        <span class="event-motion-copy copy-b"></span>
      </div>
    </div>
  </div>
)}

{kind === 'timezones' && (
  <div class="cap-graphic" aria-hidden="true">
    <div class="timezone-orbit">
      <div class="timezone-orbit-track">
        <span class="timezone-body timezone-sun">
          <Icon name="heroicons:sun-solid" />
        </span>
        <span class="timezone-body timezone-moon">
          <Icon name="heroicons:moon-solid" />
        </span>
      </div>
    </div>
    <div class="timezone-clock">
      <div class="timezone-clock-label">Event time</div>
      <div class="timezone-time-window">
        <span class="timezone-time">09:00</span>
        <span class="timezone-time alt">08:00</span>
      </div>
      <div class="timezone-offset">UTC−4 ↔ UTC−5</div>
    </div>
  </div>
)}

{kind === 'browsers' && (
  <div class="cap-graphic shield-graphic" aria-hidden="true">
    <span class="shield-aura"></span>
    <svg class="shield-mark" viewBox="0 0 72 80" fill="none">
      <path d="M36 4 63 14v21c0 19-11.7 32.4-27 40C20.7 67.4 9 54 9 35V14L36 4Z" fill="currentColor" fill-opacity=".12" stroke="currentColor" stroke-width="3"></path>
      <path class="shield-check" d="m23 38 9 9 18-20" pathLength="1" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </div>
)}

{kind === 'styling' && (
  <div class="cap-graphic live-button-graphic" aria-hidden="true" data-capability-button>
    <add-to-calendar-button name="Add to Calendar" start-date="2030-06-15" start-time="10:00" end-time="11:00" time-zone="Europe/Berlin" options="'apple','google'" button-style="default" size="3" light-mode="bodyScheme" list-style="modal" hide-rich-data hide-branding blockInteraction></add-to-calendar-button>
  </div>
)}

{kind === 'accessibility' && (
  <div class="cap-graphic" aria-hidden="true">
    <div class="access-motion-ui">
      <div class="access-control"></div>
      <div class="access-control"></div>
      <div class="access-control"></div>
      <span class="access-focus-ring"></span>
      <span class="access-tab-key">TAB</span>
      <span class="access-lock">
        <Icon name="heroicons:lock-closed" />
      </span>
    </div>
  </div>
)}

<script>
  import { LanguageCode } from '../../models/language';
  import 'add-to-calendar-button/styles/all';
  import 'add-to-calendar-button/i18n/all';
  import 'add-to-calendar-button';

  let capabilityButtonTimer: number | undefined;

  function setupCapabilityButton() {
    window.clearInterval(capabilityButtonTimer);
    capabilityButtonTimer = undefined;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const button = document.querySelector<HTMLElement>('[data-capability-button] add-to-calendar-button');
    if (!button) return;
    const languages = Object.values(LanguageCode);
    const styles = ['default', '3d', 'flat', 'round', 'text', 'date', 'neumorphism'];
    const lightBackgrounds = ['#f5f3ff', '#fff7ed', '#eff6ff', '#ecfdf5', '#fdf2f8', '#fefce8'];
    const darkBackgrounds = ['#211c2e', '#2b211c', '#182331', '#162a25', '#2b1d29', '#292817'];
    const setBackground = (index: number) => {
      const dark = document.documentElement.classList.contains('dark');
      const color = (dark ? darkBackgrounds : lightBackgrounds).at(index) ?? (dark ? '#211c2e' : '#f5f3ff');
      button.style.setProperty('--btn-background', color);
      button.style.setProperty('--date-btn-background', color);
    };
    let tick = 0;

    setBackground(0);

    capabilityButtonTimer = window.setInterval(() => {
      tick++;
      button.setAttribute('language', languages[tick % languages.length]);
      if (tick % 4 === 0) button.setAttribute('button-style', styles[(tick / 4) % styles.length]);
      if (tick % 2 === 0) setBackground((tick / 2) % lightBackgrounds.length);
    }, 500);
  }

  setupCapabilityButton();
  document.addEventListener('astro:page-load', setupCapabilityButton);
  document.addEventListener('astro:before-swap', () => window.clearInterval(capabilityButtonTimer));
</script>

<style>
  .cap-graphic {
    position: relative;
    width: 100%;
    height: 132px;
    margin-bottom: 22px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-primary) 28%, transparent);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-primary) 8%, white);
    isolation: isolate;
    user-select: none;
    -webkit-user-select: none;
  }

  :global(.dark) .cap-graphic {
    background: color-mix(in srgb, var(--color-primary) 12%, var(--color-background-dark));
  }

  .cap-graphic::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35);
    content: '';
  }

  .calendar-logo-lane {
    position: absolute;
    left: 0;
    display: flex;
    width: max-content;
    gap: 9px;
    padding-right: 9px;
    animation: calendar-logo-slide 16s linear infinite;
  }

  .calendar-logo-lane:first-child {
    top: 17px;
  }
  .calendar-logo-lane:last-child {
    bottom: 17px;
    animation-direction: reverse;
    animation-duration: 19s;
  }

  .calendar-logo-chip {
    display: grid;
    width: 52px;
    height: 42px;
    flex: 0 0 52px;
    place-items: center;
    padding: 9px;
    border: 1px solid rgb(214 211 209);
    border-radius: 10px;
    background: white;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.1);
  }

  .calendar-logo-chip :global(svg) {
    width: 100%;
    height: 100%;
  }

  @keyframes calendar-logo-slide {
    from {
      transform: translateX(-6px);
    }
    to {
      transform: translateX(calc(-50% - 4.5px));
    }
  }

  .event-motion-calendar {
    position: absolute;
    inset: 14px;
    border: 1px solid rgb(214 211 209);
    border-radius: 10px;
    background: white;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.1);
  }

  .event-motion-head {
    display: grid;
    height: 27px;
    grid-template-columns: repeat(5, 1fr);
    align-items: center;
    border-bottom: 1px solid rgb(231 229 228);
    color: rgb(120 113 108);
    font: 600 0.625rem/1 var(--font-mono);
    text-align: center;
    letter-spacing: 0.04em;
  }

  .event-motion-grid {
    position: absolute;
    inset: 27px 0 0;
    background-image: linear-gradient(to right, transparent calc(20% - 1px), rgb(231 229 228) 20%);
    background-size: 20% 100%;
  }

  .event-motion-bar,
  .event-motion-copy {
    position: absolute;
    height: 18px;
    border-radius: 5px;
  }

  .event-motion-bar {
    top: 18px;
    left: 7%;
    width: 25%;
    background: var(--color-primary);
    box-shadow: 0 5px 12px color-mix(in srgb, var(--color-primary) 20%, transparent);
    animation: event-main-shift 7.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .event-motion-bar::before {
    position: absolute;
    top: 6px;
    left: 7px;
    width: 38%;
    height: 5px;
    border-radius: 9px;
    background: rgb(255 255 255 / 0.72);
    content: '';
  }

  .event-motion-copy {
    left: 39%;
    width: 23%;
    background: var(--color-secondary-dark);
    opacity: 0;
    animation: event-copy-in 7.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .event-motion-copy.copy-a {
    top: 42px;
  }
  .event-motion-copy.copy-b {
    top: 56px;
    left: 68%;
  }

  .event-motion-mode {
    position: absolute;
    top: 7px;
    right: 9px;
    color: var(--color-primary-dark);
    font: 700 0.625rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @keyframes event-main-shift {
    0%,
    24% {
      top: 18px;
      left: 7%;
      width: 25%;
    }
    34%,
    58% {
      top: 42px;
      left: 8%;
      width: 23%;
    }
    69%,
    92% {
      top: 54px;
      left: 8%;
      width: 84%;
    }
    100% {
      top: 18px;
      left: 7%;
      width: 25%;
    }
  }

  @keyframes event-copy-in {
    0%,
    29%,
    64%,
    100% {
      opacity: 0;
      transform: translateX(-12px);
    }
    36%,
    57% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .timezone-orbit {
    position: absolute;
    top: 23px;
    left: 24px;
    width: 84px;
    height: 84px;
    border: 1px dashed color-mix(in srgb, var(--color-primary) 35%, transparent);
    border-radius: 50%;
  }

  .timezone-orbit-track {
    position: absolute;
    inset: -10px;
    animation: timezone-orbit 7s linear infinite;
  }

  .timezone-body {
    position: absolute;
    display: grid;
    width: 25px;
    height: 25px;
    place-items: center;
    border-radius: 50%;
    background: white;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
  }

  .timezone-body :global(svg) {
    width: 15px;
    height: 15px;
  }
  .timezone-sun {
    top: -3px;
    left: 39px;
    color: var(--color-secondary-dark);
  }
  .timezone-moon {
    right: 39px;
    bottom: -3px;
    color: var(--color-primary);
    transform: rotate(180deg);
  }

  .timezone-clock {
    position: absolute;
    top: 25px;
    right: 22px;
    width: 126px;
    padding: 13px 14px 12px;
    border: 1px solid rgb(214 211 209);
    border-radius: 11px;
    background: white;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.1);
  }

  .timezone-clock-label {
    margin-bottom: 5px;
    color: rgb(120 113 108);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .timezone-time-window {
    position: relative;
    height: 27px;
    overflow: hidden;
    color: rgb(41 37 36);
    font: 700 1.25rem/27px var(--font-mono);
  }
  .timezone-time {
    position: absolute;
    inset: 0;
    animation: timezone-time-a 7s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  .timezone-time.alt {
    animation-name: timezone-time-b;
  }
  .timezone-offset {
    color: var(--color-primary-dark);
    font: 600 0.625rem/1.3 var(--font-mono);
  }

  @keyframes timezone-orbit {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes timezone-time-a {
    0%,
    38%,
    100% {
      opacity: 1;
      transform: translateY(0);
    }
    48%,
    86% {
      opacity: 0;
      transform: translateY(-100%);
    }
  }
  @keyframes timezone-time-b {
    0%,
    38%,
    100% {
      opacity: 0;
      transform: translateY(100%);
    }
    48%,
    86% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .shield-graphic {
    display: grid;
    place-items: center;
  }
  .shield-aura {
    position: absolute;
    width: 82px;
    height: 82px;
    border-radius: 50%;
    background: rgb(45 190 140 / 0.14);
    animation: shield-glow 2.8s ease-in-out infinite;
  }
  .shield-mark {
    position: relative;
    width: 72px;
    height: 80px;
    color: rgb(45 190 140);
    filter: drop-shadow(0 10px 18px rgb(45 190 140 / 0.2));
  }
  .shield-check {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: shield-check-draw 2.8s ease-out infinite;
  }

  @keyframes shield-glow {
    0%,
    100% {
      opacity: 0.28;
      box-shadow: 0 0 0 0 rgb(45 190 140 / 0);
      transform: scale(0.82);
    }
    48% {
      opacity: 0.68;
      box-shadow: 0 0 32px 7px rgb(45 190 140 / 0.2);
      transform: scale(1.14);
    }
  }
  @keyframes shield-check-draw {
    0%,
    16% {
      stroke-dashoffset: 1;
    }
    52%,
    99.9% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: 1;
    }
  }

  .live-button-graphic {
    display: grid;
    place-items: center;
    padding: 12px;
    pointer-events: none;
  }
  .live-button-graphic :global(add-to-calendar-button) {
    max-width: 100%;
  }

  .access-motion-ui {
    position: absolute;
    top: 16px;
    left: 17px;
    width: calc(100% - 34px);
    height: 98px;
    padding: 14px 72px 14px 14px;
    border: 1px solid rgb(214 211 209);
    border-radius: 11px;
    background: white;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.1);
  }

  .access-control {
    height: 18px;
    margin-bottom: 8px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--color-primary) 16%, white);
  }
  .access-control:nth-child(2) {
    width: 82%;
  }
  .access-control:nth-child(3) {
    width: 62%;
    margin-bottom: 0;
  }

  .access-focus-ring {
    position: absolute;
    top: 10px;
    left: 10px;
    width: calc(100% - 88px);
    height: 26px;
    border: 2px solid var(--color-primary);
    border-radius: 7px;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 25%, transparent);
    animation: access-focus-step 4.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .access-tab-key {
    position: absolute;
    bottom: 8px;
    left: 21px;
    padding: 3px 7px;
    border: 1px solid rgb(214 211 209);
    border-radius: 5px;
    background: white;
    color: var(--color-primary-dark);
    font: 700 0.5625rem/1.2 var(--font-mono);
    letter-spacing: 0.05em;
    animation: access-tab-slide 4.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .access-lock {
    position: absolute;
    top: 24px;
    right: 17px;
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 50%;
    background: rgb(28 25 23);
    color: white;
    box-shadow: 0 8px 18px rgb(23 19 43 / 0.2);
    animation: access-lock-confirm 4.8s ease-in-out infinite;
  }

  .access-lock :global(svg) {
    width: 22px;
    height: 22px;
  }

  @keyframes access-focus-step {
    0%,
    25% {
      transform: translateY(0);
    }
    36%,
    58% {
      transform: translateY(26px);
    }
    69%,
    92% {
      transform: translateY(52px);
    }
    100% {
      transform: translateY(0);
    }
  }
  @keyframes access-tab-slide {
    0%,
    25% {
      transform: translateX(0);
    }
    36%,
    58% {
      transform: translateX(28px);
    }
    69%,
    92% {
      transform: translateX(56px);
    }
    100% {
      transform: translateX(0);
    }
  }
  @keyframes access-lock-confirm {
    0%,
    62%,
    100% {
      box-shadow: 0 8px 18px rgb(23 19 43 / 0.18);
      transform: scale(0.92);
    }
    74%,
    88% {
      box-shadow:
        0 0 0 6px rgb(45 190 140 / 0.16),
        0 8px 18px rgb(23 19 43 / 0.18);
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cap-graphic * {
      animation-play-state: paused !important;
    }
    .shield-check {
      stroke-dashoffset: 0;
    }
    .shield-aura {
      opacity: 0.48;
      transform: scale(1);
    }
  }
</style>
