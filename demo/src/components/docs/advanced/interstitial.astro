---
import { Image } from 'astro:assets';
import gift from '../../../images/gift.webp';

interface Props {
  locale: string;
  question: string;
  action: string;
  imageAlt: string;
}

const { locale, question, action, imageAlt } = Astro.props;
---

<div class="from-brand-blue-dark to-brand-blue mb-16 mt-20 w-full rounded-xl bg-gradient-to-tr text-white drop-shadow-xl transition-shadow hover:drop-shadow-2xl">
  <div class="flex flex-col sm:flex-row">
    <div class="mx-auto -mt-10 w-28 shrink-0 sm:mt-6 sm:ml-2 sm:w-1/3 md:-mt-10 md:w-1/2 md:max-w-52 lg:-mt-12 lg:ml-6 lg:max-w-64 xl:ml-10">
      <Image loading="lazy" class="drop-shadow-xl" src={gift} widths={[112, 208, 256]} sizes="(min-width: 1024px) 256px, (min-width: 768px) 208px, 112px" alt={imageAlt} />
    </div>
    <div class="flex flex-1 flex-col items-center gap-8 pt-8 pb-12 sm:pb-8 md:pt-10 md:pb-12 lg:pt-14 lg:pb-16">
      <h3 class="text-center drop-shadow-lg">{question}</h3>
      <a target="_blank" rel="author" href={`https://add-to-calendar-pro.com${locale !== 'en' ? `/${locale}` : ''}`} class="btn-accent">
        {action}
      </a>
    </div>
  </div>
</div>
