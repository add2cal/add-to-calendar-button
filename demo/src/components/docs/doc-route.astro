---
import Layout from '@layouts/default.astro';
import AdvancedPage from './advanced-page.astro';
import ConfigurationPage from './configuration-page.astro';
import ExamplesPage from './examples-page.astro';
import IntegrationPage from './integration-page.astro';
import MigrationPage from './migration-page.astro';
import WhatIsPage from './what-is-page.astro';
import { frameworkNames, type DocsLocale, type DocSlug, type FrameworkName } from './docs-data';
import { useTranslations } from '@utils/i18n';
import '@styles/content-pages.css';
interface Props { locale: DocsLocale; slug: DocSlug }
const { locale, slug } = Astro.props;
const t = useTranslations(locale);
const framework = slug.startsWith('use-with-') ? slug.slice('use-with-'.length) as FrameworkName : undefined;
if (framework && !frameworkNames.includes(framework)) throw new Error(`Unknown integration guide: ${framework}`);
const titles = new Map<DocSlug, string>([
  ['configuration', t('docs.common.configuration')],
  ['examples', t('docs.common.examples')],
  ['advanced-use', t('docs.common.advanced-use')],
  ['use', t('docs.common.installation')],
  ['what-is-an-add-to-calendar-button', t('docs.common.definition')],
  ['migration-guide-v2-to-v3', t('docs.common.migration')],
]);
const title = titles.get(slug) ?? `${t('docs.common.installation')}: ${framework}`;
const description = slug === 'configuration' ? t('docs.meta.configuration-description') : slug === 'examples' ? t('docs.meta.examples-description') : slug === 'advanced-use' ? t('docs.meta.advanced-description') : title;
---

<Layout {locale} {title} {description}>
  {slug === 'configuration' ? <ConfigurationPage {locale} /> : slug === 'examples' ? <ExamplesPage {locale} /> : slug === 'advanced-use' ? <AdvancedPage {locale} /> : slug === 'what-is-an-add-to-calendar-button' ? <WhatIsPage {locale} /> : slug === 'migration-guide-v2-to-v3' ? <MigrationPage {locale} /> : <IntegrationPage {locale} {framework} />}
</Layout>
