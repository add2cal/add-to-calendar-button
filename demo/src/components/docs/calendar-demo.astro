---
import type { AddToCalendarButtonType } from 'add-to-calendar-button';
import { atcb_generate_ssr_html_async } from 'add-to-calendar-button/ssr';
interface Props { config: AddToCalendarButtonType }
const { config } = Astro.props;
const html = await atcb_generate_ssr_html_async({
  lightMode: 'bodyScheme',
  hideBranding: true,
  ...config,
});
---

<Fragment set:html={html} />
<script>
  import 'add-to-calendar-button/styles/all';
  import 'add-to-calendar-button/i18n/de';
  import 'add-to-calendar-button/i18n/fr';
  import 'add-to-calendar-button/i18n/es';
  import 'add-to-calendar-button';
</script>
