---
import { Image } from 'astro:assets';
import { useTranslations } from '@utils/i18n';
import bomb from '@images/bomb.webp';

interface Props {
  locale: string;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);
---

<aside id="footer-banner" aria-labelledby="pro-heading" class="relative select-none z-50 w-full bg-linear-to-tr from-brand-blue-dark to-brand-blue text-white shadow-2xl">
  <div class="container grid grid-cols-1 sm:grid-cols-2">
    <div class="relative z-10 mx-auto -mt-8 w-32 sm:mx-0 sm:-mt-10 sm:w-48 md:w-64 lg:mx-auto lg:-mt-14 lg:w-80">
      <Image src={bomb} alt={t('global-promo.footer-image-alt')} widths={[128, 192, 256, 320]} sizes="(min-width: 976px) 320px, (min-width: 768px) 256px, (min-width: 576px) 192px, 128px" class="drop-shadow-xl" />
    </div>
    <div class="flex flex-col items-center gap-8 py-10 text-center md:py-16 lg:py-20">
      <div>
        <h2 id="pro-heading" class="text-3xl text-white drop-shadow-lg md:text-4xl lg:text-5xl">
          {t('global-promo.footer-heading')}
        </h2>
        <p class="mt-3 opacity-80 lg:mt-6">{t('global-promo.footer-text')}</p>
      </div>
      <a target="_blank" rel="author noopener" href={`https://add-to-calendar-pro.com${locale !== 'en' ? `/${locale}` : ''}`} class="btn-accent">
        {t('global-promo.footer-cta')}
      </a>
    </div>
  </div>
</aside>
